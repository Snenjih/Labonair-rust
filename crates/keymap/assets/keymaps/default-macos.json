// Labonair's built-in default keymap (macOS). Generated from the pre-T19-008
// `ShortcutId` table (crates/command-palette/src/keybind.rs) crossed with
// `CommandId::action_name()`. `crates/shell/src/menu.rs` still hardcodes a
// handful of OS-reserved accelerators (Cmd+, / Cmd+Shift+N / Cmd+Q / Cmd+M /
// Cmd+H / Ctrl+Cmd+F / Cmd+S) that are intentionally absent here — they are
// never user-customizable, so they never go through keymap.json.
[
  {
    "context": null,
    "bindings": {
      "cmd-p": "command_palette::Toggle",
      "cmd-shift-/": "settings::OpenShortcuts",
      "cmd-t": "tab::NewTerminal",
      "cmd-shift-p": "tab::NewPreview",
      "cmd-e": "tab::NewEditor",
      "cmd-w": "tab::Close",
      "ctrl-tab": "tab::Next",
      "ctrl-shift-tab": "tab::Prev",
      "cmd-1": "tab::Select1",
      "cmd-2": "tab::Select2",
      "cmd-3": "tab::Select3",
      "cmd-4": "tab::Select4",
      "cmd-5": "tab::Select5",
      "cmd-6": "tab::Select6",
      "cmd-7": "tab::Select7",
      "cmd-8": "tab::Select8",
      "cmd-9": "tab::Select9",
      "cmd-]": "pane::FocusNext",
      "cmd-[": "pane::FocusPrev",
      "cmd-shift-]": "tab::Next",
      "cmd-shift-[": "tab::Prev",
      "cmd-f": "search::Toggle",
      "cmd-b": "sidebar::Toggle",
      "cmd-shift-z": "view::ToggleZenMode",
      "cmd-alt-shift-m": "debug::CyclePanelDock",
      "cmd-alt-shift-z": "debug::ToggleDockZoom",
      // Chord demo (T19-008 acceptance criterion): a two-keystroke binding
      // to prove chords work end-to-end.
      "cmd-k cmd-s": "zed::OpenKeymap"
    }
  },
  {
    // Terminal-only aliases for the pane split keys (the `Pane` block below
    // holds the universal ones).
    "context": "Terminal",
    "bindings": {
      "cmd-d": "pane::SplitRight",
      "cmd-shift-d": "pane::SplitDown"
    }
  },
  {
    // `Pane` wraps every pane of a tab's pane group, whatever its kind
    // (R10-002, ADR 0005). Editor-context bindings (multi-cursor, indent,
    // fold) are deeper and win inside editor panes.
    "context": "Pane",
    "bindings": {
      "cmd-\\": "pane::SplitRight",
      "cmd-shift-\\": "pane::SplitDown",
      "cmd-k left": "pane::SplitLeft",
      "cmd-k up": "pane::SplitUp",
      "cmd-alt-left": "pane::FocusLeft",
      "cmd-alt-right": "pane::FocusRight",
      "cmd-alt-up": "pane::FocusUp",
      "cmd-alt-down": "pane::FocusDown",
      "cmd-alt-shift-left": "pane::MoveLeft",
      "cmd-alt-shift-right": "pane::MoveRight",
      "cmd-alt-shift-up": "pane::MoveUp",
      "cmd-alt-shift-down": "pane::MoveDown",
      "cmd-shift-enter": "pane::ToggleZoom",
      "cmd-shift-w": "pane::Close"
    }
  }
]
