// Labonair default settings. This is the innermost layer of the
// default < user < project merge (T19-002's SettingsStore); every value here
// must exactly match SettingsContent::defaults() — enforced by
// settings_content::tests::defaults_matches_shipped_default_json.
//
// Vocabulary note: every field here is documented at its Rust definition
// (crates/settings-content/src/*.rs) — this file re-states only what a user
// editing settings.json would need, not the full rationale.
{
  "general": {
    // "system" follows the OS appearance; "light"/"dark" pin it.
    "theme": "system",
    "restoreWindowState": true,
    // "terminal" opens one local terminal on launch; "empty" starts on the
    // empty-workspace surface.
    "defaultStartupTab": "empty",
    "checkForUpdates": true,
    "sessionRestore": false
  },

  "appearance": {
    // "default" = the built-in light/dark JSON theme.
    "appTheme": "default",
    // "default" = the built-in "Labonair" file/folder glyph set.
    "iconTheme": "default",
    "themeVariantOverrides": {},
    "appFontSize": 16,
    "appLineHeight": 1.5,
    "appFontFamily": "\"IBM Plex Sans\", sans-serif",
    "reduceMotion": false,
    // Editor/terminal text (T20-007 theme_settings layer). Empty family = the
    // theme's own mono font.
    "bufferFontFamily": "",
    "bufferFontSize": 15,
    "bufferLineHeight": 1.618,
    // "compact" | "default" | "comfortable" — spacing/size density.
    "uiDensity": "default",
    // Multiplier on the active theme's corner-radius scale (1.0 = unchanged).
    "cornerRadiusScale": 1.0,
    // "titlebar" or "sidebar".
    "tabsLocation": "titlebar",
    "zenModeShowHeader": true,
    "zenModeShowStatusbar": true
  },

  "terminal": {
    // Empty = the user's login shell.
    "terminalShell": "",
    "terminalFontFamily": "\"Lilex\", SFMono-Regular, Menlo, monospace",
    "terminalFontSize": 15,
    // Vertical line spacing as a multiple of the font size.
    "terminalLineHeight": 1.05,
    // "normal" | "medium" | "bold".
    "terminalFontWeight": "normal",
    "terminalScrollback": 5000,
    // Rows of scrollback replayed on the next launch; 0 = persist all.
    "sessionScrollbackLines": 1000,
    "scrollbackMaxSizeMb": 10,
    // 0 = keep the persisted scrollback file until the pane/session goes away.
    "scrollbackRetentionDays": 0,
    "terminalCursorStyle": "bar",
    "terminalCursorBlink": true,
    // Cursor blink half-period, in milliseconds.
    "terminalCursorBlinkInterval": 1000,
    "terminalCopyOnSelect": false,
    "terminalRightClickPastes": false,
    // Characters that end a double-click word selection.
    "terminalWordSeparator": " ()[]{}',\"`",
    // Multiplier applied to every mouse-wheel scroll step.
    "terminalScrollSensitivity": 1,
    // "none" | "alt" | "ctrl" | "shift" — held, multiplies the scroll step by 5.
    "terminalFastScrollModifier": "alt",
    "terminalBell": false,
    // Ask before closing a terminal tab whose shell is still running.
    "confirmCloseTerminalTab": false,
    // Whole-pane background opacity in percent; 100 = fully opaque.
    "terminalOpacity": 100,
    // "KEY=value,KEY2=value2" applied to every new shell.
    "terminalEnvironmentVariables": "",
    // Whitespace-separated extra shell arguments (no quoting support).
    "terminalShellArgs": ""
  },

  "editor": {
    "editorFontFamily": "\"Lilex\", SFMono-Regular, Menlo, monospace",
    "editorFontSize": 15,
    "editorLineHeight": 1.618,
    "editorTabSize": 2,
    "editorWordWrap": false,
    "editorLineNumbers": true,
    "editorRelativeLineNumbers": false,
    "editorIndentWithTabs": false,
    "editorIndentationGuides": true,
    "editorWhitespace": "none",
    "editorMinimap": false,
    "editorBracketMatching": true,
    "editorRulers": "",
    "editorScrollBeyondLastLine": true,
    "editorStickyContext": false,
    "editorDiagnostics": true,
    "editorSemanticTokens": true,
    "editorGitGutter": true,
    "editorGitWordDiff": true,
    "editorCompletion": true,
    "editorHover": true,
    "editorFormatOnSave": false,
    "editorAutoSave": false,
    "editorAutoSaveDelay": 1000,
    "editorTrimTrailingWhitespace": false,
    "editorInsertFinalNewline": false,
    "editorShowCursorPosition": true,
    "editorShowSelectionStats": false,
    "editorShowOutline": false,
    "editorAutocompleteDebounceMs": 350,
    "editorMaxFileSizeMb": 10,
    "vimMode": false,
    // Syntax colour scheme slug; "auto" (not the default) follows the app theme.
    "editorTheme": "atomone",
    // Folded in from the legacy standalone "editor" settings-file key.
    "vimHlsearch": true,
    "vimIncsearch": true,
    "vimSmartcase": true,
    "editorHighlightCurrentLine": true,
    "editorCursorBlink": true,
    // Caret blink half-period, in milliseconds.
    "editorCursorBlinkIntervalMs": 530,
    // "block" | "underline" | "bar".
    "editorCursorStyle": "bar"
  },

  "fileManager": {
    "explorerShowHiddenByDefault": false,
    "explorerIndentGuides": true,
    "explorerStickyAncestors": true,
    "explorerAutoRevealActiveFile": false,
    "explorerFoldSingleChildDirs": false,
    "explorerGitDecorations": true,
    "scmFileTree": false,

    // SFTP dual-pane browser
    "sftpShowHiddenFiles": false,
    "sftpShowUpFolder": true,
    "sftpZebraStriping": true,
    "sftpRelativeTimes": true,
    "sftpColumns": ["size", "modified", "permissions"],
    "sftpSplitRatio": 0.5,
    "sftpColumnWidths": {}
  },

  "workspace": {
    "commandPaletteSearchMode": "contains",
    "commandPaletteShowRecent": true,
    "commandPaletteOpacity": 95,
    // "top" | "high" | "center".
    "commandPalettePosition": "top",
    "commandPaletteHistorySize": 5,
    "commandPaletteCloseOnOverlayClick": true,
    // Block the first quit attempt while a terminal/SSH shell is running.
    "confirmQuitWithActiveSessions": true
  },

  "connections": {
    // Seconds to wait for the initial TCP+SSH handshake before giving up.
    "sshConnectTimeoutSecs": 20,
    // Fallback keep-alive ping interval for hosts that don't set their own.
    "sshKeepaliveIntervalSecs": 25,
    // Fallback missed-ping tolerance for hosts that don't set their own.
    "sshKeepaliveMaxFailures": 3
  },
}
